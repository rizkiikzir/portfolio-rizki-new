
---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: "id" | "en";
}

const {
  lang = "id",
  title,
  description,
  image = "/images/profile.jpg",
} = Astro.props;

const isID = lang === "id";

const resolvedTitle =
  title ?? (isID ? "Muhammad Rizki - Portofolio" : "Muhammad Rizki - Portfolio");

const resolvedDescription =
  description ??
  (isID
    ? "Portofolio Muhammad Rizki, Sarjana Terapan Teknik Informatika dengan pengalaman pengembangan web, pengolahan data GIS, dan jaringan komputer."
    : "Portfolio of Muhammad Rizki, Applied Bachelor of Informatics Engineering graduate experienced in web development, GIS data processing, and computer networks.");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="theme-color" content="#F7F7F3" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={image} />

    <!-- Custom Favicon Monogram MR -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none'%3E%3Crect width='24' height='24' rx='6' fill='%232F5249'/%3E%3Cpath d='M5 16.5V7.5L8.5 12.5L12 7.5V16.5M14.5 16.5V7.5H17.2C18.4 7.5 19.2 8.3 19.2 9.4C19.2 10.5 18.4 11.3 17.2 11.3H14.5M17 11.3L19.3 16.5' stroke='%23F7F7F3' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      {isID ? "Lewati ke konten utama" : "Skip to main content"}
    </a>
    <SiteHeader lang={lang} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter lang={lang} />

    <script src="../scripts/scroll-motion.ts"></script>
  </body>
</html>
