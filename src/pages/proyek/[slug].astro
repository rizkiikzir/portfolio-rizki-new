const { project } = Astro.props;

const ui = {
  backHref: isID ? "/#proyek" : "/en/#projects",
  backLabel: isID ? "Kembali ke Proyek" : "Back to Projects",
  backAllLabel: isID ? "Kembali ke seluruh proyek" : "Back to all projects",
  openImagePrefix: isID ? "Buka gambar penuh:" : "Open full image:",
  prevLabel: isID ? "Sebelumnya" : "Previous",
  prevAria: isID ? "Gambar sebelumnya" : "Previous image",
  nextLabel: isID ? "Berikutnya" : "Next",
  nextAria: isID ? "Gambar berikutnya" : "Next image",
  slideAria: isID ? "Tampilkan gambar" : "Show image",
  aboutHeading: isID ? "Tentang Proyek" : "Project Overview",
  focusHeading: isID ? "Fokus Pengerjaan" : "Key Contributions",
  docHeading: isID ? "Dokumentasi Teknis & Artefak" : "Technical Documentation & Artifacts",
  docDesc: isID
    ? "Dokumentasi pendukung yang memperlihatkan rancangan sistem, evaluasi teknis, dan hasil pengerjaan proyek."
    : "Supporting artifacts illustrating system architecture, technical evaluation, and project outputs.",
  techHeading: isID ? "Teknologi yang Digunakan" : "Technologies Used",
  noteLabel: isID ? "Catatan" : "Note",
  repoLabel: isID ? "Lihat Repository GitHub" : "View GitHub Repository",
  designLabel: isID ? "Lihat Desain Figma" : "View Figma Design",
};
---

<BaseLayout
  lang={lang}
  title={`${project.title} - Muhammad Rizki`}
  description={project.summary}
>
  <div class="container">
    <article class="project-detail">
      <a class="back-link" href={ui.backHref}>
        <span class="arrow-left" aria-hidden="true">←</span>
        <span>{ui.backLabel}</span>
      </a>

      <!-- PROJECT HEADER -->
      <header class="detail-header">
        <p class="detail-category mono-label">
          {project.category}
        </p>

        <h1>{project.title}</h1>

        <p class="detail-summary">
          {project.summary}
        </p>
      </header>

      <!-- PROJECT IMAGE CAROUSEL -->
      <section
        class:list={[
          "project-carousel",
          `project-carousel--${project.frameType}`,
        ]}
        data-project-carousel
        aria-label={isID ? `Galeri gambar ${project.title}` : `${project.title} image gallery`}
      >
        <div class="carousel-viewport">
          {project.slides.map((slide, index) => (
            <figure
              class="carousel-slide"
              data-carousel-slide
              hidden={index !== 0}
            >
              <div class:list={["device-frame", `device-frame--${project.frameType}`]}>
                {project.frameType === "browser" && (
                  <div class="browser-bar" aria-hidden="true">
                    <span class="browser-dots">
                      <i></i>
                      <i></i>
                      <i></i>
                    </span>
                    <span class="browser-address"></span>
                  </div>
                )}

                {project.frameType === "mobile" && (
                  <div class="mobile-speaker" aria-hidden="true"></div>
                )}

                {project.frameType === "tablet" && (
                  <span class="tablet-camera" aria-hidden="true"></span>
                )}

                <a
                  href={slide.src}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="carousel-image-link"
                  aria-label={`${ui.openImagePrefix} ${slide.caption}`}
                  title={isID ? "Klik untuk melihat ukuran penuh" : "Click to view full size"}
                >
                  <img
                    src={slide.src}
                    alt={slide.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </a>
              </div>

              <figcaption>
                {slide.caption}
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="carousel-controls">
          <button
            type="button"
            class="carousel-button"
            data-carousel-prev
            aria-label={ui.prevAria}
          >
            <span aria-hidden="true">←</span>
            <span class="control-label">{ui.prevLabel}</span>
          </button>

          <div class="carousel-pagination">
            <span
              class="carousel-count"
              data-carousel-count
              aria-live="polite"
            >
              01 / {String(project.slides.length).padStart(2, "0")}
            </span>

            <div class="carousel-indicators">
              {project.slides.map((_, index) => (
                <button
                  type="button"
                  class="carousel-indicator"
                  data-carousel-indicator
                  data-index={index}
                  aria-label={`${ui.slideAria} ${index + 1}`}
                  aria-current={index === 0 ? "true" : "false"}
                />
              ))}
            </div>
          </div>

          <button
            type="button"
            class="carousel-button"
            data-carousel-next
            aria-label={ui.nextAria}
          >
            <span class="control-label">{ui.nextLabel}</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </section>

      <!-- PROJECT INFORMATION -->
      <div class="detail-body">
        <section class="detail-section">
          <h2>{ui.aboutHeading}</h2>
          <p>{project.overview}</p>
        </section>

        <section class="detail-section">
          <h2>{ui.focusHeading}</h2>

          <ol class="activity-list">
            {project.activities.map((activity) => (
              <li>{activity}</li>
            ))}
          </ol>
        </section>

        <!-- ADDITIONAL DOCUMENTATION -->
        {project.documentation.length > 0 && (
          <section class="documentation-section">
            <header class="documentation-header">
              <h2>{ui.docHeading}</h2>
              <p>{ui.docDesc}</p>
            </header>

            {project.documentation.map((group) => (
              <div class="documentation-group">
                <div class="documentation-group-header">
                  <h3>{group.title}</h3>
                  <p>{group.description}</p>
                </div>

                <div
                  class:list={[
                    "documentation-grid",
                    group.mobile && "mobile-documentation-grid",
                  ]}
                >
                  {group.images.map((image) => (
                    <figure class="documentation-item">
                      <a
                        href={image.src}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="documentation-image-link"
                        aria-label={`${ui.openImagePrefix} ${image.caption}`}
                      >
                        <img
                          src={image.src}
                          alt={image.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>

                      <figcaption>{image.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            ))}
          </section>
        )}

        <!-- TECHNOLOGIES -->
        {project.technologies.length > 0 && (
          <section class="detail-section">
            <h2>{ui.techHeading}</h2>

            <ul class="technology-list">
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- PROJECT NOTE -->
        {project.note && (
          <aside class="project-note">
            <span class="note-label mono-label">{ui.noteLabel}</span>
            <p>{project.note}</p>
          </aside>
        )}

        <!-- EXTERNAL LINKS -->
        {(project.repository || project.design) && (
          <div class="detail-actions">
            {project.repository && (
              <a
                class="external-action-button"
                href={project.repository}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{ui.repoLabel}</span>
                <span class="arrow-up" aria-hidden="true">↗</span>
              </a>
            )}

            {project.design && (
              <a
                class="external-action-button"
                href={project.design}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{ui.designLabel}</span>
                <span class="arrow-up" aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        )}
      </div>

      <div class="detail-footer">
        <a class="back-link back-link--footer" href={ui.backHref}>
          <span class="arrow-left" aria-hidden="true">←</span>
          <span>{ui.backAllLabel}</span>
        </a>
      </div>
    </article>
  </div>

</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-project-carousel]")
    .forEach((carousel) => {
      const slides = Array.from(
        carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]")
      );

      const previousButton =
        carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");

      const nextButton =
        carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");

      const countElement =
        carousel.querySelector<HTMLElement>("[data-carousel-count]");

      const indicators = Array.from(
        carousel.querySelectorAll<HTMLButtonElement>(
          "[data-carousel-indicator]"
        )
      );

      if (slides.length === 0) return;

      let activeIndex = 0;

      const showSlide = (requestedIndex: number) => {
        activeIndex = (requestedIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          const isActive = index === activeIndex;

          slide.hidden = !isActive;
          slide.setAttribute("aria-hidden", String(!isActive));
        });

        indicators.forEach((indicator, index) => {
          indicator.setAttribute(
            "aria-current",
            String(index === activeIndex)
          );
        });

        if (countElement) {
          countElement.textContent =
            `${String(activeIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
        }
      };

      previousButton?.addEventListener("click", () => {
        showSlide(activeIndex - 1);
      });

      nextButton?.addEventListener("click", () => {
        showSlide(activeIndex + 1);
      });

      indicators.forEach((indicator, index) => {
        indicator.addEventListener("click", () => {
          showSlide(index);
        });
      });

      carousel.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          showSlide(activeIndex - 1);
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          showSlide(activeIndex + 1);
        }
      });

      showSlide(0);
    });
</script>

