          items: [
            "PostgreSQL",
            "MySQL",
            "SQLite",
            "Prisma ORM",
            "REST API",
            "JSON",
          ],
        },
        {
          title: "GIS & Information Systems",
          description:
            "Spatial mapping software and operational systems for electricity network data validation.",
          items: [
            "ArcGIS",
            "Google Earth",
            "SIUJANG",
            "AMS PLN",
          ],
