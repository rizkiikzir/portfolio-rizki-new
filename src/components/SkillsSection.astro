---

<section
  class="section skills-section"
  id={isID ? "keahlian" : "skills"}
>
  <div class="container">
    <header class="section-header">
      <span class="section-number">{content.label}</span>
      <h2 class="section-title">{content.title}</h2>
      <div class="section-divider" aria-hidden="true"></div>
    </header>

    <p class="skills-introduction" data-reveal>
      {content.introduction}
    </p>

    <div class="skills-grid">
      {content.groups.map((group) => (
        <article class="skill-group">
          <h3>{group.title}</h3>
          <p class="skill-description">{group.description}</p>

          <ul class="skill-tags" aria-label={group.title}>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-introduction {
  max-width: 42rem;
  margin-bottom: var(--space-6);
  color: var(--color-text-secondary);
  font-size: 1.0625rem;
  line-height: 1.7;
}

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--grid-gap-desktop);
  }

 .skill-group {
  min-width: 0;
  padding-block: var(--space-5);
  border-top: 1px solid var(--color-border);
}

  /* Jika jumlah grup ganjil, item terakhir melebar penuh agar tidak menyisakan ruang kosong */
  .skill-group:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .skill-group h3 {
    margin-bottom: 0.4rem;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .skill-description {
    max-width: 44rem;
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-tags li {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background-color: color-mix(in srgb, var(--color-surface) 92%, #000);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.5;
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }

  @media (hover: hover) {
    .skill-tags li:hover {
      border-color: var(--color-accent);
      color: var(--color-text-primary);
    }
  }

  @media (max-width: 1023px) {
    .skills-grid {
      column-gap: var(--grid-gap-tablet);
    }
  }

  @media (max-width: 767px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .skills-introduction {
      font-size: 1rem;
    }

    .skill-group {
      padding-block: var(--space-5);
    }

    .skill-group h3 {
      font-size: 1.125rem;
    }

    .skill-tags li {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-tags li {
      transition: none;
    }
  }
</style>