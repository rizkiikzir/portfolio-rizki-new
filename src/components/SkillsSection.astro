            "TensorFlow",
            "Keras",
            "OpenCV",
            "CNN",
            "Haar Cascade",
            "LightExNet",
            "Facial Emotion Recognition",
          ],
        },
        {
          title: "Database & API",
          description:
            "Perancangan skema basis data relasional, ORM, dan integrasi pertukaran data antar layanan.",
          items: [
            "PostgreSQL",
            "MySQL",
            "SQLite",
            "Prisma ORM",
            "REST API",
            "JSON",
          ],
        },
        {
          title: "GIS & Sistem Informasi",
          description:
            "Perangkat pemetaan spasial dan sistem operasional untuk validasi data jaringan listrik.",
          items: [
            "ArcGIS",
            "Google Earth",
            "SIUJANG",
            "AMS PLN",
          ],
