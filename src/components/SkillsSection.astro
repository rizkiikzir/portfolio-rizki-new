        },
        {
          title: "Office & Productivity Tools",
          description:
            "Pengolahan dokumen laporan, rekapitulasi spreadsheet, diagram alur sistem, dan materi presentasi.",
          items: [
            "Microsoft Word",
            "Microsoft Excel",
            "Microsoft PowerPoint",
            "Google Docs",
            "Google Sheets",
            "Google Slides",
            "Google Drive",
            "Microsoft Visio",
          ],
        },
      ]
    : [
        {
          title: "Programming & Web Development",
          description:
            "Languages and frameworks for building web interfaces, mobile applications, and backend services.",
          items: [
            "HTML",
            "CSS",
            "JavaScript",
            "TypeScript",
            "Python",
            "SQL",
            "Dart",
            "React",
            "Vite",
            "Astro",
            "Flutter",
