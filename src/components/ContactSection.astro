---
interface Props {
  lang?: "id" | "en";
}

const { lang = "id" } = Astro.props;
const isID = lang === "id";

const content = {
  label: isID ? "KONTAK" : "CONTACT",
  title: isID ? "Mari Terhubung" : "Let's Connect",
  description: isID
    ? "Terbuka untuk peluang kerja, kolaborasi proyek, maupun diskusi seputar pengembangan web, GIS, dan jaringan komputer. Silakan hubungi saya melalui kanal berikut."
    : "Open to job opportunities, project collaborations, and discussions on web development, GIS, and computer networking. Feel free to reach out through any of the channels below.",
};

const contactLinks = [
  {
    title: "LinkedIn",
    description: isID
      ? "Terhubung secara profesional"
      : "Connect professionally",
    icon: "linkedin",
    href: "https://www.linkedin.com/in/muhammadrizki4310/",
    targetBlank: true,
  },
  {
    title: "GitHub",
    description: isID
      ? "Lihat repositori proyek dan kode"
      : "Explore project repositories and code",
    icon: "github",
    href: "https://github.com/rizkiikzir",
    targetBlank: true,
  },
  {
    title: "Email",
    description: "mhdrizki4310@gmail.com",
    icon: "email",
    href: "https://mail.google.com/mail/?view=cm&fs=1&to=mhdrizki4310%40gmail.com",
    targetBlank: true,
  },
  {
    title: "WhatsApp",
    description: isID
      ? "Hubungi langsung melalui pesan"
      : "Reach out directly via message",
    icon: "whatsapp",
    href: "https://wa.me/6283830704149",
    targetBlank: true,
  },
  {
    title: "Instagram",
    description: "@zvkiann",
    icon: "instagram",
    href: "https://www.instagram.com/zvkiann/",
    targetBlank: true,
  },
  {
    title: "Curriculum Vitae",
    description: isID
      ? "Lihat atau unduh dokumen CV"
      : "View or download my CV",
    icon: "cv",
    href: "https://drive.google.com/drive/folders/1BjrmyfiATUBAbE6g-u6FK-Nepsismh6N?usp=drive_link",
    targetBlank: true,
  },
];
---

<section
  class="section contact-section"
  id={isID ? "kontak" : "contact"}
>
  <div class="container">
    <header class="section-header">
      <span class="section-number">{content.label}</span>
      <h2 class="section-title">{content.title}</h2>
      <div class="section-divider" aria-hidden="true"></div>
    </header>

    <div class="contact-content">
      <p class="contact-description">
        {content.description}
      </p>

      <div class="contact-links">
        {contactLinks.map((link) => (
          <a
            class="contact-link"
            href={link.href}
            target={link.targetBlank ? "_blank" : undefined}
            rel={link.targetBlank ? "noopener noreferrer" : undefined}
          >
            <div class="contact-link-left">
              <span class="contact-icon-box" aria-hidden="true">
                {link.icon === "linkedin" && (
                  <svg viewBox="0 0 24 24">
                    <path
                      fill="currentColor"
                      d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1-.004-4.124 2.062 2.062 0 0 1 .004 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                    />
                  </svg>
                )}

                {link.icon === "github" && (
                  <svg viewBox="0 0 24 24">
                    <path
                      fill="currentColor"
                      d="M12 0C5.372 0 0 5.373 0 12c0 5.302 3.438 9.8 8.205 11.387.6.11.82-.26.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.776.418-1.305.762-1.605-2.665-.304-5.467-1.333-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 0 1 6.006 0c2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.119 3.176.77.84 1.235 1.91 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.216.694.825.576A12.005 12.005 0 0 0 24 12C24 5.373 18.627 0 12 0Z"
                    />
                  </svg>
                )}

                {link.icon === "email" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                  </svg>
                )}

                {link.icon === "whatsapp" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20.4 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20l1.2-4.7a8.4 8.4 0 1 1 16.2-3.8Z" />
                    <path d="M8.5 8.1c.2-.5.5-.6.8-.6h.4c.2 0 .4.1.5.4l.7 1.7c.1.3.1.5-.1.7l-.5.6c-.2.2-.2.3-.1.5.4.8 1 1.4 1.8 1.9.2.1.3.1.5-.1l.7-.8c.2-.2.4-.2.6-.1l1.7.8c.3.1.4.3.4.5 0 .3-.1.7-.3.9-.3.4-.8.7-1.3.8-.6.1-1.3 0-2-.3-1.1-.4-2.1-1.1-2.9-2-.8-.9-1.3-1.8-1.5-2.6-.2-.8-.1-1.7.5-2.3Z" />
                  </svg>
                )}

                {link.icon === "instagram" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle
                      cx="17.5"
                      cy="6.5"
                      r="0.8"
                      fill="currentColor"
                      stroke="none"
                    />
                  </svg>
                )}

                {link.icon === "cv" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                    <path d="M14 2v6h6" />
                    <path d="M8 13h8M8 17h8" />
                  </svg>
                )}
              </span>

              <span class="contact-link-main">
                <span class="contact-link-title">{link.title}</span>
                <span class="contact-link-description">
                  {link.description}
                </span>
              </span>
            </div>

            <span class="contact-link-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-content {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: var(--grid-gap-desktop);
  }

  .contact-description {
    max-width: 28rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .contact-link:first-child {
    padding-top: 0;
  }

  .contact-link:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .contact-link-left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
  }

  .contact-icon-box {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background-color: color-mix(in srgb, var(--color-surface) 94%, #000);
    color: var(--color-text-secondary);
    transition:
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .contact-icon-box svg {
    width: 17px;
    height: 17px;
  }

  .contact-link-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .contact-link-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    transition: color 180ms ease;
  }

  .contact-link-description {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .contact-link-arrow {
    color: var(--color-text-secondary);
    font-size: 1.15rem;
    flex-shrink: 0;
    transition:
      transform 180ms ease,
      color 180ms ease;
  }

  @media (hover: hover) {
    .contact-link:hover .contact-icon-box {
      border-color: var(--color-accent);
      background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
      color: var(--color-accent);
    }

    .contact-link:hover .contact-link-title {
      color: var(--color-accent);
    }

    .contact-link:hover .contact-link-arrow {
      color: var(--color-accent);
      transform: translate(3px, -3px);
    }
  }

  @media (max-width: 1023px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 767px) {
    .contact-description {
      font-size: 1rem;
    }

    .contact-link-left {
      gap: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-icon-box,
    .contact-link-title,
    .contact-link-arrow {
      transition: none;
    }
  }
</style>