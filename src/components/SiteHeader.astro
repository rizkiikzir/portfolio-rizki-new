
---
import { Network } from "@lucide/astro";

interface Props {
  lang?: "id" | "en";
}

const { lang = "id" } = Astro.props;
const isIndonesian = lang === "id";
const homePath = isIndonesian ? "/" : "/en";

// Menentukan tujuan language switcher berdasarkan halaman aktif
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const idPath = currentPath.startsWith("/en/projects/")
  ? currentPath.replace(/^\/en\/projects\//, "/proyek/")
  : "/";

const enPath = currentPath.startsWith("/proyek/")
  ? currentPath.replace(/^\/proyek\//, "/en/projects/")
  : "/en";

// Navigasi utama
const navItems = isIndonesian
  ? [
      { label: "Proyek", href: `${homePath}#proyek` },
      { label: "Pengalaman", href: `${homePath}#pengalaman` },
      { label: "Tentang", href: `${homePath}#tentang` },
      { label: "Pendidikan", href: `${homePath}#pendidikan` },
      { label: "Keahlian", href: `${homePath}#keahlian` },
      { label: "Organisasi", href: `${homePath}#organisasi` },
      { label: "Kontak", href: `${homePath}#kontak` },
    ]
  : [
      { label: "Projects", href: `${homePath}#projects` },
      { label: "Experience", href: `${homePath}#experience` },
      { label: "About", href: `${homePath}#about` },
      { label: "Education", href: `${homePath}#education` },
      { label: "Skills", href: `${homePath}#skills` },
      { label: "Organizations", href: `${homePath}#organizations` },
      { label: "Contact", href: `${homePath}#contact` },
    ];
---

<header class="site-header">
  <div class="container header-inner">
    <a
      class="brand"
      href={homePath}
      aria-label={isIndonesian ? "Muhammad Rizki - Beranda" : "Muhammad Rizki - Home"}
    >
      <Network
        class="brand-icon"
        size={19}
        stroke-width={1.6}
        aria-hidden="true"
      />
      <span>MUHAMMAD RIZKI</span>
    </a>

    <nav
      class="desktop-nav"
      aria-label={isIndonesian ? "Navigasi utama" : "Main navigation"}
    >
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}

      <div
        class="language-switch"
        role="group"
        aria-label={isIndonesian ? "Pilihan bahasa" : "Language selection"}
      >
        <a
          href={idPath}
          lang="id"
          aria-current={isIndonesian ? "page" : undefined}
          class:list={{ active: isIndonesian }}
        >
          ID
        </a>

        <span aria-hidden="true">|</span>

        <a
          href={enPath}
          lang="en"
          aria-current={!isIndonesian ? "page" : undefined}
          class:list={{ active: !isIndonesian }}
        >
          EN
        </a>
      </div>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-label={isIndonesian ? "Buka menu navigasi" : "Open navigation menu"}
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-button
      data-label-open={isIndonesian ? "Buka menu navigasi" : "Open navigation menu"}
      data-label-close={isIndonesian ? "Tutup menu navigasi" : "Close navigation menu"}
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path d="M4 7H20 M4 12H20 M4 17H20" />
      </svg>
    </button>
  </div>

  <div
    class="mobile-nav-backdrop"
    data-menu-backdrop
    data-lenis-prevent
    aria-hidden="true"
  ></div>

  <nav
    class="mobile-nav"
    id="mobile-navigation"
    aria-label={isIndonesian ? "Navigasi mobile" : "Mobile navigation"}
    aria-hidden="true"
    inert
    data-lenis-prevent
    data-mobile-nav
  >
    <div class="mobile-nav-inner">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}

      <div
        class="mobile-language-switch"
        role="group"
        aria-label={isIndonesian ? "Pilihan bahasa" : "Language selection"}
      >
        <a
          href={idPath}
          lang="id"
          aria-current={isIndonesian ? "page" : undefined}
          class:list={{ active: isIndonesian }}
        >
          Indonesia
        </a>

        <a
          href={enPath}
          lang="en"
          aria-current={!isIndonesian ? "page" : undefined}
          class:list={{ active: !isIndonesian }}
        >
          English
        </a>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    height: 64px;
    background: color-mix(in srgb, var(--color-surface) 95%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.6rem;
    width: max-content;
    flex-shrink: 0;
    color: var(--color-text-primary);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .brand-icon {
    display: block;
    width: 19px;
    height: 19px;
    flex: 0 0 19px;
    color: var(--color-accent);
    transition: transform 200ms ease;
  }

  .brand:hover .brand-icon {
    transform: scale(1.08);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .desktop-nav > a {
    position: relative;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color var(--duration-normal) var(--ease-standard);
  }

  .desktop-nav > a::after {
    position: absolute;
    right: 0;
    bottom: -6px;
    left: 0;
    height: 1.5px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-normal) var(--ease-standard);
  }

  .desktop-nav > a:hover {
    color: var(--color-text-primary);
  }

  .desktop-nav > a:hover::after {
    transform: scaleX(1);
  }

  .language-switch {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .language-switch a {
    color: var(--color-text-secondary);
  }

  .language-switch a.active {
    color: var(--color-accent);
    font-weight: 700;
  }

  .language-switch a:hover {
    color: var(--color-text-primary);
  }

  .menu-toggle,
  .mobile-nav,
  .mobile-nav-backdrop {
    display: none;
  }

  /* Tablet: 768px–1023px */
  @media (min-width: 768px) and (max-width: 1023px) {
    .desktop-nav {
      gap: 0.75rem;
    }

    .desktop-nav > a {
      font-size: 0.8125rem;
    }

    .brand {
      font-size: 12px;
    }
  }

  /* Mobile: di bawah 768px */
  @media (max-width: 767px) {
    .site-header {
      height: 56px;
    }

    .header-inner {
      min-height: 56px;
    }

    .brand {
      font-size: 13px;
    }

    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 0;
      border-radius: 4px;
      background: transparent;
      color: var(--color-text-primary);
    }

    .mobile-nav-backdrop {
      position: fixed;
      inset: 56px 0 0;
      z-index: 1;
      display: block;
      visibility: hidden;
      background: transparent;
      pointer-events: none;
    }

    .mobile-nav-backdrop.is-open {
      visibility: visible;
      pointer-events: auto;
    }

    .menu-toggle svg {
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: square;
    }

    .mobile-nav {
      position: fixed;
      top: 56px;
      right: 0;
      display: block;
      width: min(360px, 100%);
      height: calc(100dvh - 56px);
      z-index: 2;
      overflow-y: auto;
      background: var(--color-surface);
      border-left: 1px solid var(--color-border);
      visibility: hidden;
      transform: translateX(100%);
      transition:
        transform var(--duration-normal) var(--ease-editorial),
        visibility var(--duration-normal);
    }

    .mobile-nav.is-open {
      visibility: visible;
      transform: translateX(0);
    }

    .mobile-nav-inner {
      display: flex;
      flex-direction: column;
      padding: var(--space-6) var(--container-gutter-mobile);
    }

    .mobile-nav-inner > a {
      padding: 0.875rem 0;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text-primary);
      font-size: 1rem;
      font-weight: 500;
    }

    .mobile-language-switch {
      display: flex;
      gap: var(--space-5);
      margin-top: var(--space-7);
      padding-top: var(--space-5);
      border-top: 1px solid var(--color-border);
    }

    .mobile-language-switch a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      color: var(--color-text-secondary);
      font-size: 0.875rem;
    }

    .mobile-language-switch a.active {
      color: var(--color-accent);
      font-weight: 700;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .desktop-nav > a::after,
    .mobile-nav,
    .brand-icon {
      transition: none;
    }
  }
</style>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(
    "[data-menu-button]"
  );

  const mobileNav = document.querySelector<HTMLElement>(
    "[data-mobile-nav]"
  );

  const menuBackdrop = document.querySelector<HTMLElement>(
    "[data-menu-backdrop]"
  );

  if (menuButton && mobileNav && menuBackdrop) {
    let previousOverflow = "";

    const closeMenu = () => {
      if (menuButton.getAttribute("aria-expanded") !== "true") return;

      const focusTarget = window.matchMedia("(min-width: 768px)").matches
        ? document.querySelector<HTMLElement>(".desktop-nav a")
        : menuButton;
      focusTarget?.focus();

      menuButton.setAttribute("aria-expanded", "false");
      menuButton.setAttribute(
        "aria-label",
        menuButton.dataset.labelOpen ?? "Open navigation menu"
      );

      mobileNav.classList.remove("is-open");
      mobileNav.inert = true;
      mobileNav.setAttribute("aria-hidden", "true");
      menuBackdrop.classList.remove("is-open");
      document.documentElement.style.overflow = previousOverflow;
      window.dispatchEvent(new Event("portfolio:mobile-nav-close"));
    };

    const openMenu = () => {
      const scrollPosition = window.scrollY;
      previousOverflow = document.documentElement.style.overflow;
      window.dispatchEvent(new Event("portfolio:mobile-nav-open"));
      document.documentElement.style.overflow = "hidden";
      window.scrollTo(0, scrollPosition);
      menuButton.setAttribute("aria-expanded", "true");
      menuButton.setAttribute("aria-label", menuButton.dataset.labelClose ?? "");
      mobileNav.classList.add("is-open");
      mobileNav.setAttribute("aria-hidden", "false");
      mobileNav.inert = false;
      menuBackdrop.classList.add("is-open");
    };

    menuButton.addEventListener("click", () => {
      if (menuButton.getAttribute("aria-expanded") === "true") {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menuBackdrop.addEventListener("click", () => {
      closeMenu();
    });

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => closeMenu());
    });

    document.addEventListener("keydown", (event) => {
      if (menuButton.getAttribute("aria-expanded") !== "true") return;

      if (event.key === "Escape") {
        closeMenu();
        return;
      }

      if (event.key !== "Tab") return;

      const links = Array.from(
        mobileNav.querySelectorAll<HTMLAnchorElement>("a")
      );
      const firstLink = links[0];
      const lastLink = links[links.length - 1];
      const activeElement = document.activeElement;

      if (activeElement === menuButton) {
        event.preventDefault();
        (event.shiftKey ? lastLink : firstLink)?.focus();
      } else if (event.shiftKey && activeElement === firstLink) {
        event.preventDefault();
        menuButton.focus();
      } else if (
        !event.shiftKey &&
        activeElement === lastLink
      ) {
        event.preventDefault();
        menuButton.focus();
      } else if (!mobileNav.contains(activeElement)) {
        event.preventDefault();
        (event.shiftKey ? lastLink : firstLink)?.focus();
      }
    });

    window.addEventListener("resize", () => {
      if (window.matchMedia("(min-width: 768px)").matches) {
        closeMenu();
      }
    });
  }
</script>
