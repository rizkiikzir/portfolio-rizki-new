---
interface Props {
  lang?: "id" | "en";
}

const { lang = "id" } = Astro.props;
const isID = lang === "id";

const content = {
  label: isID ? "ORGANISASI" : "ORGANIZATIONS",
  title: isID ? "Organisasi & Kegiatan" : "Organizations & Activities",
  entries: isID
    ? [
        {
          period: "2024 - 2025",
          organization: "KOMIT (Komunitas Mahasiswa IT Politeknik Negeri Lhokseumawe)",
          role: "Anggota Digihub",
          description:
            "Terlibat dalam pembuatan poster dan materi visual menggunakan Figma, serta berpartisipasi dalam berbagai kegiatan yang diselenggarakan oleh KOMIT DigiHub.",
          logo: "/images/organizations/komit-digihub.png",
          initials: "KD",
        },
        {
          period: "2022 - 2024",
          organization: "IECLOP (Improving English Club of Polytechnic)",
          role: "Anggota",
          description:
            "Mengikuti kelas bahasa dan berbagai kegiatan komunitas sebagai sarana untuk mengenal dan mempelajari bahasa asing, termasuk bahasa Inggris, Jepang, dan Thai.",
          logo: "/images/organizations/ieclop.png",
          initials: "IECLOP",
        },
      ]
    : [
        {
          period: "2024 - 2025",
          organization: "KOMIT DigiHub",
          role: "Member",
          description:
            "Contributed to creating posters and visual materials using Figma, and participated in various activities organized by KOMIT DigiHub.",
          logo: "/images/organizations/komit-digihub.png",
          initials: "KD",
        },
        {
          period: "2022 - 2024",
          organization: "IECLOP",
          role: "Member",
          description:
            "Participated in language classes and community activities focused on learning foreign languages, including English, Japanese, and Thai.",
          logo: "/images/organizations/ieclop.png",
          initials: "IECLOP",
        },
      ],
};
---

<section
  class="section organization-section"
  id={isID ? "organisasi" : "organizations"}
>
  <div class="container">
    <header class="section-header">
      <span class="section-number">{content.label}</span>
      <h2 class="section-title">{content.title}</h2>
      <div class="section-divider" aria-hidden="true"></div>
    </header>

    <div class="organization-list">
      {content.entries.map((entry) => (
        <article class="organization-item">
          <div class="organization-meta">
            <span class="organization-period">{entry.period}</span>
          </div>

          <div class="organization-content">
            <div
              class="organization-logo"
              aria-label={`Logo ${entry.organization}`}
            >
              <img
                src={entry.logo}
                alt={`Logo ${entry.organization}`}
                loading="lazy"
                decoding="async"
                data-organization-logo
              />
              <span class="organization-logo-fallback" aria-hidden="true">
                {entry.initials}
              </span>
            </div>

            <div class="organization-main">
              <div class="org-header">
                <h3>{entry.organization}</h3>
                <span class="org-badge">{entry.role}</span>
              </div>

              <p class="organization-description">{entry.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLImageElement>("[data-organization-logo]")
    .forEach((logo) => {
      const markLoaded = () => {
        if (logo.naturalWidth > 0) {
          logo.classList.add("is-loaded");
        } else {
          logo.hidden = true;
        }
      };

      if (logo.complete) {
        markLoaded();
      } else {
        logo.addEventListener("load", markLoaded, { once: true });
        logo.addEventListener(
          "error",
          () => {
            logo.hidden = true;
          },
          { once: true }
        );
      }
    });
</script>

<style>
  .organization-list {
    display: flex;
    flex-direction: column;
  }

  .organization-item {
    display: grid;
    grid-template-columns: minmax(0, 3.5fr) minmax(0, 7.5fr);
    align-items: start;
    gap: var(--grid-gap-desktop);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .organization-item:first-child {
    padding-top: 0;
  }

  .organization-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .organization-period {
    color: var(--color-text-primary);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .organization-content {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: start;
    gap: var(--space-4);
    min-width: 0;
  }

  .organization-logo {
    position: relative;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 7px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #ffffff;
  }

  .organization-logo img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .organization-logo img.is-loaded + .organization-logo-fallback {
    display: none;
  }

  .organization-logo-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 4px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-align: center;
  }

  .organization-main {
    min-width: 0;
  }

  .org-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--space-3);
  }

  .org-header h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .org-badge {
    padding: 0.2rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .organization-description {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 1023px) {
  .organization-item {
    grid-template-columns: 1fr;
    gap: var(--space-3);
    padding-block: var(--space-6);
  }
}

  @media (max-width: 767px) {
  .organization-content {
    grid-template-columns: 54px minmax(0, 1fr);
    gap: var(--space-3);
  }

  .organization-logo {
    width: 54px;
    height: 54px;
    padding: 6px;
  }

  .org-header h3 {
    font-size: 1.125rem;
  }

  .organization-description {
    font-size: 0.9375rem;
  }
}
</style>