---
import { getImageDimensions } from "../utils/image-dimensions";

interface Props {
  lang?: "id" | "en";
}

const { lang = "id" } = Astro.props;
const isID = lang === "id";

// Periode sementara, silakan ubah sesuai periode sebenarnya.
const content = {
  label: isID ? "PENGALAMAN" : "EXPERIENCE",
  title: isID ? "Pengalaman Kerja" : "Work Experience",
  entries: isID
    ? [
        {
          badge: "Magang",
          role: "Divisi Jaringan & Konstruksi",
          company: "PT PLN (Persero) UP3 Lhokseumawe",
          period: "Agustus 2025 - Januari 2026",
          location: "Lhokseumawe, Aceh",
          tools: ["ArcMap (GIS)", "SIUJANG Gatrik", "Microsoft Office", "AMS PLN" ],
          description: [
            "Mengolah dan memvalidasi data GIS jaringan listrik Trafo, SUTM (Saluran Udara Tegangan Menengah) dan SUTR (Saluran Udara Tegangan Rendah), meliputi pemeriksaan koordinat, layer, fitur garis, serta jarak antar tiang.",
            "Membantu rekapitulasi dan validasi data menggunakan Microsoft Excel serta pembaruan data aset melalui website SIUJANG Gatrik (Sistem Informasi Usaha Jasa Penunjang Tenaga Listrik) .",
            "Mendukung pekerjaan administrasi persuratan kontrak vendor menggunakan AMS PLN.",
            "Terlibat dalam pengerjaan sistem SIM YANTEK (Sistem Informasi Monitoring Pelayanan Teknik), bersama mentor selama masa magang.",
          ],
          photos: [
            {
              src: "/images/experience/pln1.webp",
              alt: "Dokumentasi kegiatan magang di PT PLN UP3 Lhokseumawe",
            },
            {
              src: "/images/experience/pln2.webp",
              alt: "Aktivitas pekerjaan selama magang di PT PLN",
            },
            {
              src: "/images/experience/pln3.webp",
              alt: "Dokumentasi aktivitas pengolahan data jaringan listrik",
            },
            {
              src: "/images/experience/pln4.webp",
              alt: "Dokumentasi lingkungan kerja selama magang di PT PLN",
            },
          ],
        },
        {
          badge: "Magang",
          role: "Teknisi Komputer",
          company: "Difa Computer",
          period: "Agustus 2021 - November 2021",
          location: "Paya Demam Dua, Aceh Timur",
          tools: ["Hardware Diagnostics", "OS Installation", "Troubleshooting"],
          description: [
            "Melakukan pemeriksaan, perawatan, dan troubleshooting perangkat keras maupun perangkat lunak komputer.",
            "Menangani instalasi sistem operasi, driver, aplikasi pendukung, serta kebutuhan teknis perangkat pelanggan.",
          ],
          photos: [
            {
              src: "/images/experience/difa1.webp",
              alt: "Dokumentasi kegiatan magang di Difa Computer",
            },
            {
              src: "/images/experience/difa2.webp",
              alt: "Aktivitas pemeriksaan komputer di Difa Computer",
            },
            {
              src: "/images/experience/difa3.webp",
              alt: "Dokumentasi perawatan perangkat komputer di Difa Computer",
            },
            {
              src: "/images/experience/difa4.webp",
              alt: "Dokumentasi aktivitas teknisi selama magang di Difa Computer",
            },
          ],
        },
      ]
    : [
        {
          badge: "Internship",
          role: "Network & Construction Division",
          company: "PT PLN (Persero) UP3 Lhokseumawe",
          period: "September 2025 - December 2025",
          location: "Lhokseumawe, Aceh",
          tools: ["ArcMap (GIS)", "SIUJANG", "Microsoft Excel", "AMS PLN", "SIM-YANTEK"],
          description: [
            "Processed and validated GIS data for SUTM and SUTR electricity networks, including coordinate, layer, line feature, and pole-distance checks.",
            "Assisted with data recapitulation and validation in Microsoft Excel alongside asset record updates in the SIUJANG application.",
            "Supported administrative and correspondence tasks using AMS PLN.",
            "Contributed to the SIM-YANTEK system project under mentor supervision during the internship.",
          ],
          photos: [
            {
              src: "/images/experience/pln1.webp",
              alt: "Internship documentation at PT PLN UP3 Lhokseumawe",
            },
            {
              src: "/images/experience/pln2.webp",
              alt: "Work activity during the PLN internship",
            },
            {
              src: "/images/experience/pln3.webp",
              alt: "Electricity network data processing documentation",
            },
            {
              src: "/images/experience/pln4.webp",
              alt: "Workplace documentation during the PLN internship",
            },
          ],
        },
        {
          badge: "Internship",
          role: "Computer Technician",
          company: "Difa Computer",
          period: "January 2022 - March 2022",
          location: "Paya Demam Dua, East Aceh",
          tools: ["Hardware Diagnostics", "OS Installation", "Troubleshooting"],
          description: [
            "Performed computer hardware and software inspection, routine maintenance, and troubleshooting.",
            "Handled operating system and software installations as well as technical support requests.",
          ],
          photos: [
            {
              src: "/images/experience/difa1.webp",
              alt: "Internship documentation at Difa Computer",
            },
            {
              src: "/images/experience/difa2.webp",
              alt: "Computer inspection activity at Difa Computer",
            },
            {
              src: "/images/experience/difa3.webp",
              alt: "Computer maintenance documentation at Difa Computer",
            },
            {
              src: "/images/experience/difa4.webp",
              alt: "Technician activity during the Difa Computer internship",
            },
          ],
        },
      ],
};
---

<section
  class="section experience-section"
  id={isID ? "pengalaman" : "experience"}
>
  <div class="container">
    <header class="section-header">
      <span class="section-number">{content.label}</span>
      <h2 class="section-title">{content.title}</h2>
      <div class="section-divider" aria-hidden="true"></div>
    </header>

    <div class="experience-list">
      {content.entries.map((entry) => (
        <article class="experience-item">
          <div class="experience-meta">
            <span class="experience-period">
              {entry.period}
            </span>

            <span class="experience-location">
              {entry.location}
            </span>

            <div
              class="experience-tools"
              role="group"
              aria-label={isID ? "Alat dan teknologi" : "Tools & Technologies"}
            >
              {entry.tools.map((tool) => (
                <span class="tool-tag">{tool}</span>
              ))}
            </div>
          </div>

          <div class="experience-content">
            <div class="role-header">
              <h3>{entry.role}</h3>
              <span class="role-badge">{entry.badge}</span>
            </div>

            <p class="experience-company">{entry.company}</p>

            <ul>
              {entry.description.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <div class="experience-gallery">
              {entry.photos.map((photo) => (
                <figure class="experience-photo">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    {...getImageDimensions(photo.src)}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-list {
    display: flex;
    flex-direction: column;
  }

.experience-item {
  display: grid;
  grid-template-columns: minmax(0, 3.5fr) minmax(0, 7.5fr);
  align-items: start;
  gap: var(--grid-gap-desktop);
  padding-block: var(--space-7);
  border-bottom: 1px solid var(--color-border);
}

  .experience-item:first-child {
    padding-top: 0;
  }

  .experience-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .experience-meta {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .experience-period {
    color: var(--color-text-primary);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .experience-location {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .experience-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-4);
  }

  .tool-tag {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background-color: color-mix(in srgb, var(--color-surface) 92%, #000);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .experience-content {
    min-width: 0;
  }

  .role-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--space-2);
  }

  .role-header h3 {
    margin: 0;
  }

  .role-badge {
    padding: 0.2rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .experience-company {
    margin-bottom: var(--space-5);
    color: var(--color-accent);
    font-weight: 600;
  }

  .experience-content ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .experience-content li {
    padding-left: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .experience-content li::marker {
    color: var(--color-accent);
  }

  /* Gallery: 4 photos in a 2x2 grid */
  .experience-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .experience-photo {
    aspect-ratio: 4 / 3;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-border);
  }

  .experience-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  @media (hover: hover) {
    .experience-photo:hover img {
      transform: scale(1.02);
    }
  }

/* Tablet */
@media (max-width: 1023px) {
  .experience-item {
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .experience-meta {
    position: static;
  }

  .experience-tools {
    margin-top: var(--space-2);
  }
}

/* Mobile */
@media (max-width: 767px) {
  .experience-content li {
    font-size: 0.9375rem;
  }

  .experience-gallery {
    gap: var(--space-2);
  }
}

  @media (prefers-reduced-motion: reduce) {
    .experience-photo img {
      transition: none;
    }
  }
</style>